        "helpContent": {
            "outfile_ALGGRASSR.MAPCALCULATOR_9": "Total LCOE for PV on-grid systems (US$/MWh)", 
            "outfile_ALGGRASSR.MAPCALCULATOR_8": "LCOE for connection to grid (US$/MWh) of PV on grid systems", 
            "ALG_DESC": "This model computes the Levelized Cost of Electriciy (LCOE) for PV on-grid systems in ECOWAS region.\n\nLCOE components for generation, transmission and road construction are computed separately, then summed up to derive the total LCOE, expressed in Euro/MWh.", 
            "dni": "Direct Normal Irradiance in KWh/m2/year\nFile: DNI_ecowas.tif, output from module 2.1", 
            "outfile_ALGGRASSR.MAPCALCULATOR_2": "LCOE for generation (US$/MWh) with PV on grid systems", 
            "outfile_ALGGRASSR.MAPCALCULATOR_6": "LCOE for read construction (US$/MWh) for PV on grid systems", 
            "ALG_HELP_CREATOR": "Giacomo Delli \nSE4ALL EU-TAF expert \nThe EU 's Technical Assistance Facility (TAF) \nfor the Sustainable Energy for All (SE4ALL) initiative Central and Western Africa", 
            "roads": "Road network, as provided by WAPP.\nFile: groads_ecowas.shp. \nThe field FCLASS is used for unselecting Trails\n", 
            "ecowpop": "Population Density, as provided by ECREEE \nFile: ecreee_ecowpop.tif", 
            "rclrulesecowpop": "File: ClassificationRules\\GeogrPotential\\ReclassPopulationDensity_PV-ongrid.txt", 
            "rclrulesghi": "File: ClassificationRules\\GeogrPotential\\ReclassGHI.txt", 
            "outfile_ALGGRASSR.MAPCALCULATOR_11": "LCOE for generation (US$/MWh) with CSP no storage systems", 
            "rclrulesroads": "File: ClassificationRules\\GeogrPotential\\ReclassDistanceRoads_PV-ongrid.txt", 
            "outfile_ALGGRASSR.MAPCALCULATOR_13": "LCOE for read construction (US$/MWh) for CSP no storage systems", 
            "outfile_ALGGRASSR.MAPCALCULATOR_12": "LCOE for connection to grid (US$/MWh) of CSP no storage systems", 
            "outfile_ALGGRASSR.MAPCALCULATOR_15": "LCOE for connection to grid (US$/MWh) of CSP 6 hr storage systems", 
            "outfile_ALGGRASSR.MAPCALCULATOR_14": "Total LCOE for CSP no storage systems (US$/MWh)", 
            "outfile_ALGGRASSR.MAPCALCULATOR_17": "Total LCOE for CSP 6 hr storage systems (US$/MWh)", 
            "outfile_ALGGRASSR.MAPCALCULATOR_16": "LCOE for read construction (US$/MWh) for CSP 6 hr storage systems", 
            "MASKED_ALGSAGAGRIDMASKING_2": "Geographical Potential for PV on-grid systems, based on the presently existing transmission lines + planned lines up to 2020\n\nEquation: \u01a9 (FactorClass * FactorWeight)\n\nWeights are those used by the Univerisity of Geneva. They can be computed with the Spreadsheet AHP_GeogrPot.xlsx, using a simplified version of the Analytical Hierarchy Process.\n", 
            "MASKED_ALGSAGAGRIDMASKING_3": "Geographical Potential for PV on-grid systems, based on the presently existing transmission lines + planned lines up to 2030\n\nEquation: \u01a9 (FactorClass * FactorWeight)\n\nWeights are those used by the Univerisity of Geneva. They can be computed with the Spreadsheet AHP_GeogrPot.xlsx, using a simplified version of the Analytical Hierarchy Process.\n", 
            "rcldistsettlements": "File: ClassificationRules\\GeogrPotential\\ReclassDistanceSettlements.txt", 
            "MASKED_ALGSAGAGRIDMASKING_1": "Total LCOE (US$/MWh) for PV on grid systems", 
            "rcllandcoverurban": "File: ClassificationRules\\GeogrPotential\\ReclassLandCover_Urban.txt", 
            "exclusionmaskpvongrid": "Exclusion Areas for PV on-grid systems.\nRaster File, output from Module 1.2 ", 
            "ALG_VERSION": "2.0", 
            "landcover": "Land Cover layer, as downloaded from https://www.iscgm.org/gmd/ \nFile: gm_lc_v3.tif", 
            "exclusionareasmask": "Exclusion Areas Mask for PV on-grid systems (output from module 1.2)", 
            "rcldistancegridlines": "File: ClassificationRules\\GeogrPotential\\ReclassDistanceGridLines_PV-ongrid.txt", 
            "OUTPUT_ALGGDALOGRTRANSLATE_1": "Total LCOE (Euro/MWh) for PV on grid systems", 
            "ALG_CREATOR": "Giacomo Delli \nSE4ALL EU-TAF expert \nThe EU 's Technical Assistance Facility (TAF) \nfor the Sustainable Energy for All (SE4ALL) initiative Central and Western Africa", 
            "transmissionlines": "TransmissionLines.shp, lines, as provided by WAPP.\nThe fields Voltage and Situation are used to select existing grid lines with Voltage > 50kV", 
            "outfile_ALGGRASSR.MAPCALCULATOR_10": "LCOE for generation (US$/MWh) with CSP 6 hr storage systems", 
            "referencegrid1km": "Reference Grid for all layers, resolution: 1 km\nRaster File: ReferenceGrid1000.tif\n", 
            "wdpawa": "WDPA_July2016_wa.shp. \nSource file (WDPA_July2016-shapefile.zip) was downloaded from http://www.protectedplanet.net/ , then clipped in ArcGIS on the boundaries of Ecowas region", 
            "ghi": "Global Horizontal Irradiance in KWh/m2/day\nFile:GHI_ecowas.tif, output from module 2.1"
        }, 

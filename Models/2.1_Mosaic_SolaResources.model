        "helpContent": {
            "dniecowas": "Direct Normal Irradiance, computed by Cener, in kWh/m2/year. . Coverage : Continental West Africa. Spatial resolution: 1070m. \n\nRaster file: dni.tif", 
            "ALG_DESC": "This model mosaics GHI and DNI layers for Continental Africa and Cabo Verde", 
            "ALG_CREATOR": "Giacomo Delli \nSE4ALL EU-TAF expert \nThe EU 's Technical Assistance Facility (TAF) \nfor the Sustainable Energy for All (SE4ALL) initiative Central and Western Africa", 
            "OUTPUT_ALGGDALOGRMERGE_2": "GHI Mosaic for ECOWAS region", 
            "OUTPUT_ALGGDALOGRMERGE_1": "DNI Mosaic for ECOWAS region", 
            "ghicaboverde": "Global Horizontal Irradiance computed by NOVELTIS, in kWh/m2/year. Coverage: Cabo Verde. Spatial resolution: 8000m. Projection: lat/long\n\nRaster File: CapeVerde_GHI.tif", 
            "ghiecowas": "Global Horizontal Irradiance computed by Nexant - 3Tier, in kWh/m2/day. Coverage : Continental West Africa. Spatial resolution: 1070m. \n\nRaster file: ghi.tif", 
            "dnicaboverde": "Direct Normal Irradiance computed by NOVELTIS, in kWh/m2/year. Coverage: Cabo Verde. Spatial resolution: 8000m. Projection: lat/long\n\nRaster File: CapeVerde_DNI.tif", 
            "ALG_HELP_CREATOR": "Giacomo Delli \nSE4ALL EU-TAF expert \nThe EU 's Technical Assistance Facility (TAF) \nfor the Sustainable Energy for All (SE4ALL) initiative Central and Western Africa", 
            "ALG_VERSION": "1.0"
        }, 

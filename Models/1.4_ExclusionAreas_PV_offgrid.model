        "helpContent": {
            "ALG_DESC": "Computes Exclusion Areas for PV-offgrid technology", 
            "glwd3": "Water bodies, as downloaded from http://www.worldwildlife.org/pages/global-lakes-and-wetlands-database \nFile: glwd_3 (ESRI grid)", 
            "ecowasadmboundaries": "Administrative boundaries, as provided by ECREE\nVector File: ECOWAS_admin.shp", 
            "fllodzonesreclassrules": "File: ClassificationRules\\1_ExclusionAreas\\ReclassFloodZones.txt ", 
            "referencegrid1000": "Reference Grid for all layers, resolution: 1 km\nRaster File: ReferenceGrid1000.tif\n", 
            "landcoverreclassrules": "File: ClassificationRules\\1_ExclusionAreas\\ReclassLandCover_PVoffgrid.txt ", 
            "rivers": "Rivers, as downloaded from http://www.naturalearthdata.com/downloads/10m-physical-vectors/ \nVector file: ne_10m_rivers_lake_centerlines.shp ", 
            "ALG_CREATOR": "Giacomo Delli \nSE4ALL EU-TAF expert \nThe EU 's Technical Assistance Facility (TAF) \nfor the Sustainable Energy for All (SE4ALL) initiative Central and Western Africa", 
            "floodzones": "Flood zones (frequency), as downloaded from http://preview.grid.unep.ch/index.php?preview=data&events=floods&evcat=2 \nFile: fl_frequency. tif", 
            "ALG_VERSION": "2.0", 
            "ALG_HELP_CREATOR": "Giacomo Delli \nSE4ALL EU-TAF expert \nThe EU 's Technical Assistance Facility (TAF) \nfor the Sustainable Energy for All (SE4ALL) initiative Central and Western Africa", 
            "landcover": "Land Cover layer, as downloaded from https://www.iscgm.org/gmd/ \nFile: gm_lc_v3.tif\n", 
            "output_ALGGRASSR.CROSS_1": "Exclusion Areas Layer mask for PV off-grid systems\nValues:\n0 = Excluded\n1 = Included\n\nLayer computed by multiplying all input layers \n\n", 
            "wbreclassrules": "File: ClassificationRules\\1_ExclusionAreas\\ReclassWaterBodies.txt ", 
            "wdpa": "WDPA_July2016_wa.shp. \nSource file (WDPA_July2016-shapefile.zip) was downloaded from http://www.protectedplanet.net/ , then clipped on the boundaries of Ecowas region "
        }, 

            "fllodzonesreclassrules": "File: ClassificationRules\\1_ExclusionAreas\\ReclassFloodZones.txt", 
            "referencegrid1000": "Reference Grid for all layers, resolution: 1 km\nRaster File: ReferenceGrid1000.tif\n", 
            "landcoverreclassrules": "File: ClassificationRules\\1_ExclusionAreas\\ReclassLandCover_PVongrid.txt", 
            "railways": "Railway network, as provided by ECREEE\nVector file: spat_rail.shp", 
            "slopereclassrules": "File: ClassificationRules\\1_ExclusionAreas\\ReclassSlope_PVongrid.txt", 
            "elevationreclassrules": "File: ClassificationRules\\ExclusionAreas\\ReclassElevation.txt", 

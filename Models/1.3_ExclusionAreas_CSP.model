            "slope": "Slope in % for ECOWAS region, output from module 1.1. \nFile: slope_wa.tif", 
            "ALG_DESC": "Computes Exclusion Areas fo CSP technology", 
            "ecpwpop": "Population Density, as provided by ECREEE \nFile: ecreee_ecowpop.tif", 
            "elevation": "Elevation in m. for ECOWAS region, output from module 1.1 \nFile: srtm_wa.itf", 
            "glwd3": "Water bodies, as downloaded from http://www.worldwildlife.org/pages/global-lakes-and-wetlands-database \nFile: glwd_3 (ESRI grid)", 
            "fllodzonesreclassrules": "File: ClassificationRules\\1_ExclusionAreas\\ReclassFloodZones.txt", 
            "referencegrid1000": "Reference Grid for all layers, resolution: 1 km \nRaster File: ReferenceGrid1000.tif", 
            "landcoverreclassrules": "File: ClassificationRules\\1_ExclusionAreas\\ReclassLandCover_CSP.txt", 
            "railways": "Railway network, as provided by ECREEE \nVector file: spat_rail.shp", 
            "slopereclassrules": "File: ClassificationRules\\1_ExclusionAreas\\ReclassSlope_CSP.txt", 
            "elevationreclassrules": "File: ClassificationRules\\ExclusionAreas\\ReclassElevation.txt", 
            "rivers": "Rivers, as downloaded from http://www.naturalearthdata.com/downloads/10m-physical-vectors/ \nVector file: ne_10m_rivers_lake_centerlines.shp ", 
            "ALG_CREATOR": "Giacomo Delli \nSE4ALL EU-TAF expert \nThe EU 's Technical Assistance Facility (TAF) \nfor the Sustainable Energy for All (SE4ALL) initiative Central and Western Africa", 
            "floodzones": "Flood zones (frequency), as downloaded from http://preview.grid.unep.ch/index.php?preview=data&events=floods&evcat=2 \nFile: fl_frequency. tif", 
            "ALG_VERSION": "2.0", 
            "ALG_HELP_CREATOR": "Giacomo Delli \nSE4ALL EU-TAF expert \nThe EU 's Technical Assistance Facility (TAF) \nfor the Sustainable Energy for All (SE4ALL) initiative Central and Western Africa", 

            "output_ALGGRASSR.CROSS_1": "Exclusion Areas Layer mask for CSP systems.\nValues:\n0 = Exscluded\n1 = Included\n\nLayer computed multiplying each input layer", 
            "wbreclassrules": "File: ClassificationRules\\1_ExclusionAreas\\ReclassWaterBodies.txt", 
            "wdpa": "WDPA_July2016_wa.shp. \nSource file (WDPA_July2016-shapefile.zip) was downloaded from http://www.protectedplanet.net/ , then clipped on the boundaries of Ecowas region", 
            "ecowpopreclassrules": "File: ClassificationRules\\ExclusionAreas\\ReclassPopulationDensity.txt"
